# Apache / LiteSpeed (e.g. Hostinger) rules for the prerendered build.
# Every public page is a real file (dist/<path>/index.html); client-only app
# routes get the app shell; anything else is a real 404.
# Keep the legacy redirects in sync with src/content/legacyRedirects.ts
# (the build checks) and with vercel.json / _redirects.

Options -MultiViews -Indexes
# /courses must not be redirected to /courses/ — canonical URLs have no trailing slash.
DirectorySlash Off
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Legacy URLs → new URLs. Straight to the canonical https://cadseekho.com
  #    so http/www variants also take a single hop.
  RewriteRule ^blog/Deep\sHoles/?$ https://cadseekho.com/blog/deep-hole-drilling-design-guide [R=301,L,NC]
  RewriteRule ^blog/Stress\sConcentration/?$ https://cadseekho.com/blog/stress-concentration-factor [R=301,L,NC]
  RewriteRule ^courses/Solidworks\sSimulation\sfor\sBegginner/?$ https://cadseekho.com/courses/solidworks-simulation-for-beginners [R=301,L,NC]
  RewriteRule ^downloads/?$ https://cadseekho.com/resources [R=301,L]
  RewriteCond %{THE_REQUEST} \s/index\.html[\s?]
  RewriteRule ^index\.html$ https://cadseekho.com/ [R=301,L]

  # 2. Trailing slash → none (except the root), also fixing host/scheme in the same hop.
  RewriteCond %{REQUEST_URI} !^/$
  RewriteRule ^(.+)/$ https://cadseekho.com/$1 [R=301,L]

  # 3. www → non-www and http → https, one hop. (X-Forwarded-Proto covers
  #    hosts that terminate TLS at a proxy and pass HTTPS=off.)
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://cadseekho.com%{REQUEST_URI} [R=301,L]
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://cadseekho.com%{REQUEST_URI} [R=301,L]

  # 4. Client-only routes (not prerendered, noindex) → the app shell.
  RewriteRule ^(login|signup|forgot-password|reset-password|dashboard)$ /app.html [L]
  RewriteRule ^(admin|classroom)(/.*)?$ /app.html [L]

  # 5. Prerendered pages: /path → /path/index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.+)$ /$1/index.html [L]

  # 6. Anything else that isn't a real file → 404 (served from /404.html).
  RewriteCond %{REQUEST_URI} !^/$
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ - [R=404,L]
</IfModule>

<IfModule mod_headers.c>
  # Hashed build assets never change — cache for a year.
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css|woff2?|ttf|webp|png|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Supabase project settings (Project Settings → API in the Supabase dashboard)
# Safe to expose in the frontend build — these are the public anon key/URL, not secrets.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Never put the service-role key here. It must never ship in frontend code or env
# vars prefixed with VITE_ (those are inlined into the client bundle at build time).

# Optional: used only by scripts/generate-sitemap.mjs at build time. Defaults
# to https://cadseekho.com if unset.
VITE_SITE_URL=https://cadseekho.com

# Cloudflare Turnstile (bot protection on signup). Site key is public —
# get both from the Cloudflare dashboard (Turnstile → your widget).
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key

# TURNSTILE_SECRET_KEY is NOT set here — this file only covers variables the
# frontend build reads. The secret is used exclusively by the
# signup-with-turnstile Supabase Edge Function and must be set as an Edge
# Function secret instead, never as a project env var:
#   supabase secrets set TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Supabase project settings (Project Settings → API in the Supabase dashboard)
# Safe to expose in the frontend build — these are the public anon key/URL, not secrets.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Never put the service-role key here. It must never ship in frontend code or env
# vars prefixed with VITE_ (those are inlined into the client bundle at build time).

# Optional: used only by scripts/generate-sitemap.mjs at build time. Defaults
# to https://cadseekho.com if unset.
VITE_SITE_URL=https://cadseekho.com

# Supabase project settings (Project Settings → API in the Supabase dashboard)
# Safe to expose in the frontend build — these are the public anon key/URL, not secrets.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Never put the service-role key here. It must never ship in frontend code or env
# vars prefixed with VITE_ (those are inlined into the client bundle at build time).

# Optional: canonical origin for canonical URLs, JSON-LD and the sitemap
# (https, no www, no trailing slash). Defaults to https://cadseekho.com.
VITE_SITE_URL=https://cadseekho.com

# Optional (SEO): Google Search Console "HTML tag" verification token — just the
# content="..." value — and the GA4 measurement ID. Injected into every
# prerendered page by scripts/prerender.mjs; leave empty to skip.
VITE_GSC_VERIFICATION=
VITE_GA4_ID=

# Optional (ads): Meta Pixel ID — numeric, from Events Manager. The base code is
# written into every prerendered public page by scripts/prerender.mjs; events
# fire from src/lib/metaPixel.ts. Never loaded on /login, /admin, /dashboard or
# /classroom. Leave empty to skip.
VITE_META_PIXEL_ID=

# Optional (ads): Google Ads tag ID (AW-123456789) and the conversion labels
# from Google Ads → Goals → Conversions → (action) → Tag setup → "Use Google
# tag" (the part after the slash in send_to 'AW-…/label'). Leave the labels
# empty if you import conversions from GA4 instead. All events go through
# src/lib/track.ts.
VITE_GOOGLE_ADS_ID=
VITE_GOOGLE_ADS_LEAD_LABEL=
VITE_GOOGLE_ADS_PURCHASE_LABEL=
VITE_GOOGLE_ADS_CONTACT_LABEL=

# Optional (ads): Meta Business → Brand safety → Domains → meta-tag method —
# just the content="..." value. Written into every prerendered page.
VITE_META_DOMAIN_VERIFICATION=

# Cloudflare Turnstile (bot protection on signup). Site key is public —
# get both from the Cloudflare dashboard (Turnstile → your widget).
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key

# TURNSTILE_SECRET_KEY is NOT set here — this file only covers variables the
# frontend build reads. The secret is used exclusively by the
# signup-with-turnstile Supabase Edge Function and must be set as an Edge
# Function secret instead, never as a project env var:
#   supabase secrets set TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Razorpay checkout — none of these go in this file either. The browser gets
# the (public) key id from create-razorpay-order at checkout time, so there's
# no VITE_ variable. Set all three as Edge Function secrets (rzp_test_ keys
# first; swap to rzp_live_ only after a full test-mode purchase works):
#   supabase secrets set RAZORPAY_KEY_ID=rzp_test_...
#   supabase secrets set RAZORPAY_KEY_SECRET=your-key-secret
#   supabase secrets set RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# Demo leads (submit-lead Edge Function) — Edge Function secrets, not here.
# TURNSTILE_SECRET_KEY / RESEND_API_KEY / ADMIN_NOTIFICATION_EMAIL are shared
# with signup and notify-registration. See scripts/google-sheet-webhook.gs.
#   supabase secrets set GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/.../exec
#   supabase secrets set SHEET_SECRET=<same random string as the Apps Script property>
#   supabase secrets set TELEGRAM_BOT_TOKEN=<optional>  TELEGRAM_CHAT_ID=<optional>
